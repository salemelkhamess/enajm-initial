msgstr "لم يتم تحديد أي تلميذ للإضافة."

#, python-format
msgid "%(n)d élève(s) retiré(s) du groupe %(g)s."
msgstr "تمت إزالة %(n)d تلميذ من المجموعة %(g)s."

